# Required: Google AI Studio Free-Tier Gemini API Key
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here

# Strictly Free-Tier Gemini Model (Allowed: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash, gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Server & Storage Configuration
PORT=8000
HOST=0.0.0.0
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=500
TARGET_CLIP_WIDTH=1080
TARGET_CLIP_HEIGHT=1920
CORS_ORIGINS=*
